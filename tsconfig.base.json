{
  // Shared TypeScript base for the frontend SPAs. Each SPA's tsconfig.json
  // extends this and adds its own `include` and test-runner `types`.
  //
  // `strict` is on here since the v11 cycle (H-D.3): every SPA source and
  // every test file is TypeScript, so the per-package `strict: true` overrides
  // that carried this while the conversion ran are gone. `checkJs` stays off
  // on purpose: the only JavaScript left in a program is the classic theme JS
  // under oneirodex/setup/default_theme/js/, which admin tests import as-is —
  // it is volume-served vanilla JS with its own harness, not SPA source.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  }
}
