# for docker, replace localhost with db in the database_url
# NOTE: Existing installs may still use database name "gametheca" — only change if migrating.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gametheca
# you only need to configure a test database if you plan to run the unit tests
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gamethecatest
# point this to the root folder where your gamesare stored
DATA_FOLDER_WAREZ=/
BASE_FOLDER_WINDOWS=C:\
BASE_FOLDER_POSIX=/
SECRET_KEY=put_your_own_secret_string_here_32617432
# this folder is where the app will store static files like cover images and themes
# for non-docker installs, this path is relative to where you run the app
# for docker installs, set LIBRARY_HOST_PATH in .env instead (see .env.docker.example)
UPLOAD_FOLDER=./gametheca/static/library
# set to true during development to force theme files to be recopied on startup (helpful for theme development)
DEV_MODE=false
# port for the web server to run on (defaults to 5006 if not set)
PORT=5006
# these are only used by the docker setup, you can ignore them if not using docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gametheca
# OIDC / SSO (disabled unless OIDC_ENABLED=true and enabled in Admin → Integrations)
OIDC_ENABLED=false
OIDC_ISSUER_URL=https://auth.example.com/application/o/gametheca/
OIDC_CLIENT_ID=gametheca
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://gametheca.example.com/login/oidc/callback
OIDC_SCOPES=openid email profile
OIDC_ROLE_CLAIM=groups
OIDC_ROLE_MAP={"admin":"admin","gametheca-admin":"admin","librarian":"librarian","gametheca-librarian":"librarian","child":"child","gametheca-child":"child"}
OIDC_DISPLAY_NAME=Sign in with SSO
# Session cookies — set false only for local HTTP dev; use true behind HTTPS reverse proxy
SESSION_COOKIE_SECURE=true
REMEMBER_COOKIE_SECURE=true
# Trusted reverse-proxy hops (0=off, 1=single nginx/Caddy/Traefik in front). Enables X-Forwarded-Proto for OIDC.
TRUSTED_PROXIES=0
# SteamGridDB artwork provider (grids/covers only — get a key at https://www.steamgriddb.com/profile/preferences)
STEAMGRIDDB_API_KEY=
# GiantBomb metadata (optional cover search)
GIANTBOMB_API_KEY=
# Optional *arr module (Prowlarr/Jackett + qBittorrent). Also toggleable in Admin.
ENABLE_ARR_MODULE=false
PROWLARR_URL=
PROWLARR_API_KEY=
JACKETT_URL=
JACKETT_API_KEY=
QBITTORRENT_URL=
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=
# Encrypt emulator save blobs at rest (Fernet derived from SECRET_KEY)
ENCRYPT_EMULATOR_SAVES=false
# Optional Ollama AI assist (suggestions; apply needs second flag)
ENABLE_AI_ASSIST=false
ENABLE_AI_AUTO_APPLY=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Hardlink helpers — preview when helpers on; apply needs second flag
ENABLE_HARDLINK_HELPERS=false
ALLOW_HARDLINK_APPLY=false
# Wire completed qBittorrent downloads → hardlink preview/apply (also needs hardlink flags)
ENABLE_ARR_HARDLINK_PIPELINE=false
# Mobile / Quest-browser VR catalog (browse only) + installable PWA
ENABLE_VR_BROWSE=false
