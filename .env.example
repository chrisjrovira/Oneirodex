# GameTheca environment example
#
# Docker / Unraid Compose:
#   Prefer copying .env.unraid.example (Unraid), .env.docker.example, or .env.nas.example
#   instead of this file.
#   Compose always connects to the "db" service (never localhost inside the container).
#
# Native (non-Docker) install on the same machine as Postgres:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gametheca

# --- Native / local Postgres (non-Docker) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gametheca
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gamethecatest

# --- Docker Compose uses these (host paths for volume mounts) ---
# DATA_FOLDER_GAMES is the HOST path; compose mounts it to /storage in the container.
DATA_FOLDER_GAMES=/path/to/your/games

# Extra scan locations beyond DATA_FOLDER_GAMES: a NAS share, a second disk,
# an external drive. GameTheca scans anything this machine can open, so the
# share must already be mounted here — mounting it is an OS-level step.
# Pipe-separated; each entry may carry a "Label=" prefix for the folder browser.
#   GT_LIBRARY_ROOTS=NAS ROMs=/mnt/nas/roms|Archive=/mnt/archive/games
# Windows: prefer UNC paths over mapped drive letters (mapped drives are
# per-user and do not exist for a service). See:
# docs/runbooks/remote-scan-locations.md
GT_LIBRARY_ROOTS=
LIBRARY_HOST_PATH=./data/library
# Optional household BIOS mount (Compose) — appdata host path, not games.
# Prefer .env.unraid.example. Never commit firmware binaries.
# EMULATOR_BIOS_PATH=/app/gametheca/static/library/bios
# EMULATOR_BIOS_HOST_PATH=/mnt/user/appdata/gametheca/bios
BASE_FOLDER_WINDOWS=C:\
BASE_FOLDER_POSIX=/

SECRET_KEY=put_your_own_secret_string_here_32617432
UPLOAD_FOLDER=./gametheca/static/library
DEV_MODE=false
PORT=5006
# Uvicorn workers (Docker entrypoint). Default 1 for SSE/schedulers; override to 2 OK.
UVICORN_WORKERS=1
# Background work hard caps (prevent scan/image turbo from pinning Unraid CPU)
# GT_SCAN_THREAD_CAP=4
# GT_IMAGE_DOWNLOAD_THREAD_CAP=4
# GT_IMAGE_DOWNLOAD_BATCH_CAP=100
# GT_WORKER_YIELD_MS=5
# Optional library root-folder incremental watch (default OFF). When 1, watches
# each library last_scan_folder except libraries with watch_enabled=false
# (per-lib opt-out). Scan-depth–aware leaf folders only; not deep arcade ROM
# trees. Debounces 2–5s and enqueues ScanJobs via the FIFO queue.
# Unraid FUSE/bind-mount may miss host-side renames — see unraid-deploy.md.
# GT_LIBRARY_WATCH=0
# GT_LIBRARY_WATCH_DEBOUNCE_SEC=3
# Optional debounce for library-added staff digests (seconds, 2–30; default 5):
# GT_LIBRARY_ADD_NOTIFY_DEBOUNCE_SEC=5
# See docs/runbooks/unraid-deploy.md § Library root watch
# See docs/admin/library-root-watch-spike.md

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gametheca
DATABASE_HOST=db
DATABASE_PORT=5432

# OIDC / SSO (optional — local login always works)
OIDC_ENABLED=false
OIDC_ISSUER_URL=https://auth.example.com/application/o/gametheca/
OIDC_CLIENT_ID=gametheca
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://gametheca.example.com/login/oidc/callback
OIDC_SCOPES=openid email profile
OIDC_ROLE_CLAIM=groups
OIDC_ROLE_MAP={"admin":"admin","gametheca-admin":"admin","librarian":"librarian","gametheca-librarian":"librarian","child":"child","gametheca-child":"child"}
OIDC_DISPLAY_NAME=Sign in with SSO

# Session cookies — false for local HTTP; true behind HTTPS
SESSION_COOKIE_SECURE=false
REMEMBER_COOKIE_SECURE=false
TRUSTED_PROXIES=0

STEAMGRIDDB_API_KEY=
GIANTBOMB_API_KEY=
# Optional — Class D identify search (GET /api/search_metadata?source=mobygames).
# Empty/missing → honest empty results (no 500). https://www.mobygames.com/info/api/
MOBYGAMES_API_KEY=
# Optional — Class D identify / covers (GET /api/search_metadata?source=thegamesdb|tgdb).
# Empty/missing → honest empty results (no 500). https://thegamesdb.net/api/register.php
THEGAMESDB_API_KEY=
# Meta/Quest identify: default IGDB Quest platforms. Modes: igdb|csv_only|disabled|unofficial_graphql
META_QUEST_API_MODE=igdb
# Optional — reserved for future official Meta catalog (not required for IGDB identify).
META_GRAPH_ACCESS_TOKEN=
# Explicit opt-in only — never default-on. Unofficial GraphQL stub stays empty.
META_QUEST_UNOFFICIAL_GRAPHQL=0

ENABLE_ARR_MODULE=true
ENABLE_DEBRID=true
ENABLE_GAME_ASSISTS=true
ENABLE_MOD_TRACKING=true
# Companion Flips IPS/BPS apply (needs FLIPS_PATH for actual apply)
ENABLE_ROM_PATCH_APPLY=true
FLIPS_PATH=
# DAT unique-hash: open zip/7z/rar and hash inner dump when outer archive hash misses (default on)
DAT_HASH_INNER_ARCHIVE=true
# Operator-owned patch guide catalog (YAML/JSON). No third-party DB scrape.
ENABLE_PATCH_CATALOG=true
PATCH_CATALOG_PATH=
# RetroArch AI Service overlay hints (companion / native RetroArch only)
ENABLE_ROM_AI_TRANSLATE=true
RETROARCH_AI_SERVICE_URL=
ENABLE_ACTIVITY_FEED=true
ENABLE_FREE_GAMES=true
# Which sites the News page pulls gaming headlines from. Replaces the built-in
# list entirely; comma or pipe separated. http(s) only — the server fetches
# these, so anything else is refused and the defaults are kept.
#   GT_NEWS_FEEDS=https://www.polygon.com/rss/index.xml,https://www.pcgamer.com/rss/
GT_NEWS_FEEDS=
FREE_GAMES_POLL_HOURS=3

# Discover's on-box recommender: taste profiles and title similarity, rebuilt on
# a schedule. Everything is derived from signals this install already stores and
# nothing leaves the box. Turn it off and Discover keeps working — the rows that
# depend on it simply do not appear.
ENABLE_DISCOVER_ML=true
# Hours between rebuilds (clamped 1-168). Taste moves slowly; nightly is ample.
DISCOVER_ML_REBUILD_HOURS=24
# Batched email digest (unread mentions/DMs/free games); needs Admin SMTP + member opt-in
ENABLE_EMAIL_DIGEST=true
EMAIL_DIGEST_INTERVAL_HOURS=24
ENABLE_LOGIN_RATE_LIMIT=true
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
ENABLE_PCDOS_BROWSER=true
# ENABLE_RUFFLE — read by utils/ruffle_play but nothing calls it, and the Ruffle
# player is not vendored. Left here (and in config.py) so the plumbing survives,
# but the admin toggle was removed: it could not change anything.
ENABLE_RUFFLE=true
# Malware scan (ClamAV when reachable + filename heuristics)
ENABLE_MALWARE_SCAN=true
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_SOCKET=
MALWARE_SCAN_BLOCK_ON_HIT=true
REAL_DEBRID_TOKEN=
ALLDEBRID_API_KEY=
PREMIUMIZE_API_KEY=
TORBOX_API_KEY=
PROWLARR_URL=
PROWLARR_API_KEY=
JACKETT_URL=
JACKETT_API_KEY=
QBITTORRENT_URL=
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=
TRANSMISSION_URL=
TRANSMISSION_USERNAME=
TRANSMISSION_PASSWORD=
DELUGE_URL=
DELUGE_PASSWORD=
SABNZBD_URL=
SABNZBD_API_KEY=
NZBGET_URL=
NZBGET_USERNAME=
NZBGET_PASSWORD=

ENCRYPT_EMULATOR_SAVES=false

ENABLE_AI_ASSIST=true
ENABLE_AI_AUTO_APPLY=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Generated cover art — off by default. Point at your OWN endpoint; the a1111
# engine speaks the API that AUTOMATIC1111, SD.Next and Forge all implement.
# Nothing leaves your network and there is no key to buy.
ENABLE_AI_ARTWORK=false
AI_ARTWORK_URL=
AI_ARTWORK_ENGINE=a1111

# Check version / updates / DLC after a library scan. Off by default because
# each check is outbound store HTTP traffic; the limit caps a big first scan.
SCAN_CHECK_FRESHNESS=false
SCAN_FRESHNESS_LIMIT=50

# Theme fonts. Empty FONT_PATH = gametheca/static/library/fonts.
# Font files are operator-supplied — see docs/admin/theme-fonts-and-images.md
FONT_PATH=
FONT_MAX_BYTES=8388608

ENABLE_HARDLINK_HELPERS=true
ALLOW_HARDLINK_APPLY=false
ENABLE_ARR_HARDLINK_PIPELINE=true
# Remote path mapping — set this when your download client runs in a different
# container than GameTheca. qBittorrent reports paths from ITS mounts, so
# without a mapping the hardlink pipeline stats a path that does not exist here
# and reports "no source file found" even though the file is present.
# Format: "remote=>local" pairs joined by "|".
#   ARR_REMOTE_PATH_MAP=/downloads=>/storage/downloads|/data/torrents=>/mnt/user/torrents
ARR_REMOTE_PATH_MAP=


ENABLE_VR_BROWSE=true

# Homelab — allow *arr/Ollama connector URLs on RFC1918 LAN (metadata IP still blocked)
ALLOW_PRIVATE_LAN_URLS=true
# Do not overwrite existing user roles from OIDC groups on each login (default on)
OIDC_LOCK_ROLES=true

# BYO challenge / captcha solver sidecar (FlareSolverr-compatible TRAWL) — opt-in only
# Compose profile `challenge` (Ops) + CHALLENGE_SOLVER_URL=http://trawl:8191 when sidecar is up
ENABLE_CHALLENGE_SOLVER=false
CHALLENGE_SOLVER_URL=
CHALLENGE_SOLVER_PROVIDER=flaresolverr_compat
CHALLENGE_SOLVER_TIMEOUT_MS=60000
CHALLENGE_SOLVER_MAX_TIER=5
# Optional token CAPTCHA API (CapSolver-style) when provider=token_api
CHALLENGE_TOKEN_API_URL=
CHALLENGE_TOKEN_API_KEY=

# LiveKit voice (on by default; needs secrets + compose profile `livekit` for SFU)
ENABLE_LIVEKIT=true
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# BYO Sunshine / Wolf remote play (Moonlight clients) — opt-in only
ENABLE_REMOTE_PLAY=false
SUNSHINE_BASE_URL=
WOLF_BASE_URL=
REMOTE_PLAY_PROVIDER=sunshine
REMOTE_PLAY_HOST_LABEL=
REMOTE_PLAY_APP_HINT=
REMOTE_PLAY_PIN_HINT=
REMOTE_PLAY_TOKEN_HINT=

# Ambient lighting bridge (Hyperion.ng / Home Assistant) — opt-in only
ENABLE_AMBIENT_LIGHTING=false
LIGHTING_PROVIDER=off
# Hyperion direct: http://192.168.x.x:8090  (requires ALLOW_PRIVATE_LAN_URLS=true)
HYPERION_URL=
HYPERION_TOKEN=
HYPERION_PRIORITY=50
AMBIENT_ACCENT_COLOR=255,128,32
# Home Assistant REST: long-lived token + entity/scene ids
HA_URL=
HA_TOKEN=
HA_LIGHT_ENTITIES=
HA_PLAY_SCENE=
HA_STOP_SCENE=

# In-app support → GitHub Issues (PAT with issues:write; skip sync if unset)
SUPPORT_GITHUB_TOKEN=
SUPPORT_GITHUB_REPO=chrisjrovira/gametheca

# --- Challenge / captcha solver (opt-in — default OFF) ---
# Enable only when you run TRAWL/FlareSolverr and need JS/captcha bypass for acquire.
# Compose: docker compose --profile challenge up -d  then set URL below.
ENABLE_CHALLENGE_SOLVER=false
# With Compose profile `challenge`: CHALLENGE_SOLVER_URL=http://trawl:8191
# External LAN solver: http://192.168.x.x:8191  (requires ALLOW_PRIVATE_LAN_URLS=true)
CHALLENGE_SOLVER_URL=
CHALLENGE_SOLVER_PROVIDER=flaresolverr_compat
CHALLENGE_SOLVER_TIMEOUT_MS=60000
CHALLENGE_SOLVER_MAX_TIER=5
# Old NAS CPU / kernel <5.1 — set in .env when using Compose profile (not read by app):
# TRAWL_IMAGE=ghcr.io/germondai/trawl:baseline
