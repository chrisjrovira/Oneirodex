{
  "name": "gametheca-desktop",
  "private": true,
  "version": "1.0.0-beta",
  "description": "GameTheca desktop companion (Tauri 2)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:thin": "tsc --noEmit && vite build --mode thin",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:thin": "tauri build --config src-tauri/tauri.thin.conf.json"
  },
  "dependencies": {
    "@oneirodex/api-client": "file:../../frontend/api-client",
    "@tauri-apps/api": "^2.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
