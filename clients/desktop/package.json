{
  "name": "oneirodex-desktop",
  "private": true,
  "version": "1.0.0-beta",
  "description": "Oneirodex desktop companion (Tauri 2)",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:thin": "tsc --noEmit && vite build --mode thin",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "npm --prefix ../.. run lint",
    "format:check": "npm --prefix ../.. run format:check",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:thin": "tauri build --config src-tauri/tauri.thin.conf.json"
  },
  "dependencies": {
    "@oneirodex/api-client": "*",
    "@tauri-apps/api": "^2.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
