# Docker-specific environment configuration for GameTheca
# Copy this file to .env when using Docker and customize the values
# NOTE: Existing installs may still use database name "gametheca" — only change if migrating.

# Database connection - NOTE: Use 'db' as hostname for Docker Compose setup
DATABASE_URL=postgresql://postgres:postgres@db:5432/gametheca

# Test database (only needed if running unit tests)
TEST_DATABASE_URL=postgresql://postgres:postgres@db:5432/gamethecatest

# Game storage directory - mounted as volume in docker-compose.yml
DATA_FOLDER_WAREZ=/storage

# Base folders (for path resolution)
BASE_FOLDER_WINDOWS=C:\
BASE_FOLDER_POSIX=/

# Flask secret key — REQUIRED. The container will not start with the placeholder.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Host path for persistent library storage (cover images, themes, zips)
# This is mounted into the container - use a path relative to docker-compose.yml
LIBRARY_HOST_PATH=./data/library

# Development mode - set to true during theme development
DEV_MODE=false

# Docker-specific PostgreSQL configuration
# These variables are used by the postgres container in docker-compose.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gametheca

# Additional Docker configuration
# Database host for internal container communication
DATABASE_HOST=db
DATABASE_PORT=5432

# --- Optional modules (off by default; flip to true as needed) ---
# Local HTTP cookies (set true only behind HTTPS reverse proxy)
SESSION_COOKIE_SECURE=false
REMEMBER_COOKIE_SECURE=false
TRUSTED_PROXIES=0

# *arr (Prowlarr/Jackett + qBittorrent). Use host.docker.internal for services on the Docker host.
ENABLE_ARR_MODULE=false
ENABLE_ARR_HARDLINK_PIPELINE=false
PROWLARR_URL=
PROWLARR_API_KEY=
JACKETT_URL=
JACKETT_API_KEY=
QBITTORRENT_URL=http://host.docker.internal:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=

# AI assist (Ollama on host by default)
ENABLE_AI_ASSIST=false
ENABLE_AI_AUTO_APPLY=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# Hardlinks (often blocked on Docker RO game mounts — enable only if dest is writable same-volume)
ENABLE_HARDLINK_HELPERS=false
ALLOW_HARDLINK_APPLY=false

# VR / Quest browse PWA at /vr
ENABLE_VR_BROWSE=false

# OIDC / Authentik (optional; leave false for local-only)
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
