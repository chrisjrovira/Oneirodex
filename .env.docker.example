# Docker / Unraid Compose environment for GameTheca
# Copy to .env and set SECRET_KEY (+ host game path).
#
# IMPORTANT:
# - Do NOT set DATABASE_URL to localhost.
# - docker-compose.yml builds DATABASE_URL with host "db" automatically.
# - DATA_FOLDER_GAMES must be a HOST path (compose mounts it to /storage).
# - DATA_FOLDER_WAREZ is a deprecated alias — still accepted for existing .env files.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gametheca
DATABASE_HOST=db
DATABASE_PORT=5432

SECRET_KEY=

# Host path to your games library
DATA_FOLDER_GAMES=/mnt/user/infernal-data-streams/_software/_games
LIBRARY_HOST_PATH=/mnt/cache/appdata/gametheca/library

# Optional private BIOS mount (household only — never ship firmware in git/image).
# Uncomment the bios bind in docker-compose.yml when set.
# EMULATOR_BIOS_PATH=/app/gametheca/static/library/bios
# EMULATOR_BIOS_HOST_PATH=/mnt/user/appdata/gametheca/bios

DEV_MODE=false
SESSION_COOKIE_SECURE=false
REMEMBER_COOKIE_SECURE=false
TRUSTED_PROXIES=0
# Uvicorn workers — default 1 (SSE/schedulers); override to 2 OK
UVICORN_WORKERS=1

ENABLE_ARR_MODULE=false
ENABLE_ARR_HARDLINK_PIPELINE=false
# Homelab: allow *arr/Ollama connector base URLs on RFC1918 (metadata IP still blocked)
ALLOW_PRIVATE_LAN_URLS=false
PROWLARR_URL=
PROWLARR_API_KEY=
JACKETT_URL=
JACKETT_API_KEY=
QBITTORRENT_URL=
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=

ENABLE_AI_ASSIST=false
ENABLE_AI_AUTO_APPLY=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

ENABLE_HARDLINK_HELPERS=false
ALLOW_HARDLINK_APPLY=false

ENABLE_VR_BROWSE=false

OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# Optional LiveKit voice (compose --profile livekit)
ENABLE_LIVEKIT=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# In-app support → GitHub Issues
SUPPORT_GITHUB_TOKEN=
SUPPORT_GITHUB_REPO=chrisjrovira/gametheca

# Optional challenge solver (compose --profile challenge) — off by default
ENABLE_CHALLENGE_SOLVER=false
CHALLENGE_SOLVER_URL=http://trawl:8191
CHALLENGE_SOLVER_PROVIDER=flaresolverr_compat
CHALLENGE_SOLVER_TIMEOUT_MS=60000
CHALLENGE_SOLVER_MAX_TIER=5
# TRAWL_IMAGE=ghcr.io/germondai/trawl:baseline   # old NAS / no AVX2

# Ambient lighting (Hyperion.ng / Home Assistant) — off by default
ENABLE_AMBIENT_LIGHTING=false
LIGHTING_PROVIDER=off
HYPERION_URL=
HYPERION_TOKEN=
HA_URL=
HA_TOKEN=
HA_LIGHT_ENTITIES=
