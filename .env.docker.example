# Docker / Unraid Compose environment for Oneirodex
# Copy to .env and set SECRET_KEY (+ host game path).
#
# IMPORTANT:
# - Do NOT set DATABASE_URL to localhost.
# - docker-compose.yml builds DATABASE_URL with host "db" automatically.
# - DATA_FOLDER_GAMES must be a HOST path (compose mounts it to /storage).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=oneirodex
DATABASE_HOST=db
DATABASE_PORT=5432

SECRET_KEY=

# Host path to your games library
DATA_FOLDER_GAMES=/mnt/user/infernal-data-streams/_software/_games
LIBRARY_HOST_PATH=/mnt/cache/appdata/oneirodex/library

# Extra scan locations, as the CONTAINER sees them. Docker binds what the host
# has already mounted — it does not speak SMB/NFS itself. So: mount the share on
# the host, uncomment a LIBRARY_ROOT_*_HOST_PATH bind in docker-compose.yml, and
# list the CONTAINER path here (/storage2, not the host path).
#   LIBRARY_ROOT_2_HOST_PATH=/mnt/user/roms
#   ONEIRODEX_LIBRARY_ROOTS=NAS ROMs=/storage2|Archive=/storage3
# Compose interpolates ONEIRODEX_LIBRARY_ROOTS and GT_LIBRARY_ROOTS.
# See docs/runbooks/remote-scan-locations.md
ONEIRODEX_LIBRARY_ROOTS=
GT_LIBRARY_ROOTS=
LIBRARY_ROOT_2_HOST_PATH=
LIBRARY_ROOT_3_HOST_PATH=
LIBRARY_ROOT_4_HOST_PATH=

# Optional private BIOS mount (household only — never ship firmware in git/image).
# Uncomment the bios bind in docker-compose.yml when set.
# EMULATOR_BIOS_PATH=/app/oneirodex/static/library/bios
# EMULATOR_BIOS_HOST_PATH=/mnt/user/appdata/oneirodex/bios
# Folder of dumps already on the server (boot import + Admin → Emulators scan).
# BIOS_IMPORT_SOURCE=/app/oneirodex/static/library/bios-pack

DEV_MODE=false
SESSION_COOKIE_SECURE=false
REMEMBER_COOKIE_SECURE=false
TRUSTED_PROXIES=0
# Uvicorn workers — default 1 (SSE/schedulers); override to 2 OK
UVICORN_WORKERS=1

ENABLE_ARR_MODULE=false
ENABLE_ARR_HARDLINK_PIPELINE=false
# Remote path mapping — set this when your download client runs in a different
# container than Oneirodex. qBittorrent reports paths from ITS mounts, so
# without a mapping the hardlink pipeline stats a path that does not exist here
# and reports "no source file found" even though the file is present.
# Format: "remote=>local" pairs joined by "|".
#   ARR_REMOTE_PATH_MAP=/downloads=>/storage/downloads|/data/torrents=>/mnt/user/torrents
ARR_REMOTE_PATH_MAP=

# Homelab: allow *arr/Ollama connector base URLs on RFC1918 (metadata IP still blocked)
ALLOW_PRIVATE_LAN_URLS=false
PROWLARR_URL=
PROWLARR_API_KEY=
JACKETT_URL=
JACKETT_API_KEY=
QBITTORRENT_URL=
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=

ENABLE_AI_ASSIST=false
ENABLE_AI_AUTO_APPLY=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# Generated cover art — off by default, self-hosted only.
#   Sidecar on this host:  docker compose --profile artwork up -d
#                          AI_ARTWORK_URL=http://sdnext:7860
#   GPU on another box:    AI_ARTWORK_URL=http://<gpu-host>:7860 and skip
#                          the profile entirely — it is only an HTTP call.
# The sidecar runs on CPU unless you opt into docker-compose.gpu.yml via
# COMPOSE_FILE, which requires a real NVIDIA driver on the Docker host.
ENABLE_AI_ARTWORK=false
AI_ARTWORK_URL=
AI_ARTWORK_ENGINE=a1111

# Version / update / DLC checks after a scan (outbound store traffic — opt in)
SCAN_CHECK_FRESHNESS=false
SCAN_FRESHNESS_LIMIT=50

# Theme fonts. Leave FONT_PATH empty: the default lives under the library
# volume, so uploaded fonts survive a rebuild.
FONT_PATH=
FONT_MAX_BYTES=8388608

ENABLE_HARDLINK_HELPERS=false
ALLOW_HARDLINK_APPLY=false

ENABLE_VR_BROWSE=false

OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# Optional LiveKit voice (compose --profile livekit)
ENABLE_LIVEKIT=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# In-app support → GitHub Issues
SUPPORT_GITHUB_TOKEN=
SUPPORT_GITHUB_REPO=chrisjrovira/oneirodex

# Optional challenge solver (compose --profile challenge) — off by default
ENABLE_CHALLENGE_SOLVER=false
CHALLENGE_SOLVER_URL=http://trawl:8191
CHALLENGE_SOLVER_PROVIDER=flaresolverr_compat
CHALLENGE_SOLVER_TIMEOUT_MS=60000
CHALLENGE_SOLVER_MAX_TIER=5
# TRAWL_IMAGE=ghcr.io/germondai/trawl:baseline   # old NAS / no AVX2

# Ambient lighting (Hyperion.ng / Home Assistant) — off by default
ENABLE_AMBIENT_LIGHTING=false
LIGHTING_PROVIDER=off
HYPERION_URL=
HYPERION_TOKEN=
HA_URL=
HA_TOKEN=
HA_LIGHT_ENTITIES=

# Security headers default on in config.py (CSP_ENFORCE=true). Override only if
# you need report-only: CSP_ENFORCE=false
# Optional household ownership tokens (register-only, never downloads):
# STEAM_WEB_API_KEY=
# GOG_REFRESH_TOKEN=
# EPIC_DEVICE_AUTH={"account_id":"","device_id":"","secret":""}
# AMAZON_REFRESH_TOKEN=
# AMAZON_DEVICE_SERIAL=
# AMAZON_NILE_JSON=
# APP_IMAGE=chrisjrovira/oneirodex:1.0.0-beta
# APP_CONTAINER_NAME=oneirodex-app
# DB_CONTAINER_NAME=oneirodex-db
