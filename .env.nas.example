# Unraid Compose .env template (no secrets in git)
# cp .env.nas.example .env  then set SECRET_KEY
# Live Unraid .env is this checkout:
#   /mnt/user/infernal-data-streams/_projects/Oneirodex/.env
# /mnt/user/isos/gametheca/ is retired — do not copy there.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gametheca
DATABASE_HOST=db
DATABASE_PORT=5432

SECRET_KEY=

# Host path on Unraid (Compose mounts this read-only to /storage)
DATA_FOLDER_GAMES=/mnt/user/infernal-data-streams/_software/_games
LIBRARY_HOST_PATH=/mnt/cache/appdata/gametheca/library
# Extra scan locations — CONTAINER paths, one RO bind each in docker-compose.yml.
#   LIBRARY_ROOT_2_HOST_PATH=/mnt/user/roms
#   ONEIRODEX_LIBRARY_ROOTS=NAS ROMs=/storage2
# Compose interpolates both keys; ONEIRODEX_ wins inside the app if both are set.
# See docs/runbooks/remote-scan-locations.md
ONEIRODEX_LIBRARY_ROOTS=
GT_LIBRARY_ROOTS=
# Optional private BIOS (appdata — not games). Uncomment compose bios bind when set.
# EMULATOR_BIOS_PATH=/app/gametheca/static/library/bios
# EMULATOR_BIOS_HOST_PATH=/mnt/user/appdata/gametheca/bios
# BIOS_IMPORT_SOURCE=/app/gametheca/static/library/bios-pack

UPLOAD_FOLDER=/app/gametheca/static/library
DEV_MODE=false
PORT=5006
# Uvicorn workers — default 1 (SSE/schedulers); override to 2 OK
UVICORN_WORKERS=1
SESSION_COOKIE_SECURE=false
REMEMBER_COOKIE_SECURE=false
TRUSTED_PROXIES=0

ENABLE_ARR_MODULE=false
ENABLE_ARR_HARDLINK_PIPELINE=false
# Homelab Unraid: set true so Prowlarr/qBit/NZBGet at http://192.168.x.x can be saved
ALLOW_PRIVATE_LAN_URLS=false
ENABLE_AI_ASSIST=false
ENABLE_AI_AUTO_APPLY=false
ENABLE_HARDLINK_HELPERS=false
ALLOW_HARDLINK_APPLY=false
ENABLE_VR_BROWSE=false
OIDC_ENABLED=false

# Optional LiveKit voice (compose --profile livekit)
ENABLE_LIVEKIT=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# In-app support → GitHub Issues
SUPPORT_GITHUB_TOKEN=
SUPPORT_GITHUB_REPO=chrisjrovira/oneirodex

# Optional challenge solver (compose --profile challenge) — off by default
ENABLE_CHALLENGE_SOLVER=false
CHALLENGE_SOLVER_URL=http://trawl:8191
CHALLENGE_SOLVER_PROVIDER=flaresolverr_compat
CHALLENGE_SOLVER_TIMEOUT_MS=60000
CHALLENGE_SOLVER_MAX_TIER=5
# TRAWL_IMAGE=ghcr.io/germondai/trawl:baseline   # old NAS / no AVX2

# CSP enforces by default in config.py. Report-only: CSP_ENFORCE=false
# STEAM_WEB_API_KEY=
# GOG_REFRESH_TOKEN=
# EPIC_DEVICE_AUTH={"account_id":"","device_id":"","secret":""}
# AMAZON_REFRESH_TOKEN=
# AMAZON_DEVICE_SERIAL=
# AMAZON_NILE_JSON=
