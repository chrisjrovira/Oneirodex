# Unraid Compose .env template (no secrets in git)
# cp .env.nas.example .env  then set SECRET_KEY
# Copy .env to NAS: /mnt/user/isos/gametheca/.env

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gametheca
DATABASE_HOST=db
DATABASE_PORT=5432

SECRET_KEY=

# Host path on Unraid (Compose mounts this read-only to /storage)
DATA_FOLDER_WAREZ=/mnt/user/infernal-data-streams/_software/_games
LIBRARY_HOST_PATH=/mnt/cache/appdata/gametheca/library

UPLOAD_FOLDER=/app/gametheca/static/library
DEV_MODE=false
PORT=5006
SESSION_COOKIE_SECURE=false
REMEMBER_COOKIE_SECURE=false
TRUSTED_PROXIES=0

ENABLE_ARR_MODULE=false
ENABLE_ARR_HARDLINK_PIPELINE=false
ENABLE_AI_ASSIST=false
ENABLE_AI_AUTO_APPLY=false
ENABLE_HARDLINK_HELPERS=false
ALLOW_HARDLINK_APPLY=false
ENABLE_VR_BROWSE=false
OIDC_ENABLED=false
