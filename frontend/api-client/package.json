{
  "name": "@oneirodex/api-client",
  "version": "1.0.0-beta",
  "private": true,
  "description": "Minimal typed fetch client for Oneirodex OpenAPI endpoints",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "exports": {
    ".": "./src/index.ts"
  },
