# Static uploads and generated files (these should be mounted as volumes or generated)
gametheca/static/library/images/
gametheca/static/library/zips/
gametheca/static/library/themes/

# Docker library host path (default mount point for persistent library data)
#
# Root-anchored deliberately. As a bare `data/` this matched a directory of that
# name at ANY depth, which silently swallowed `gametheca/data/` — package data
# that is read at runtime and has to ship: the generated per-system loading
# motifs and the Arr indexer presets. Both existed only on the machine that
# generated them, so the features worked in dev and were missing in every built
# image. Keep the leading slash.
/data/

# OS
.DS_Store
Thumbs.db
# Git worktrees
.worktrees/

# Frontend bundles (built by the Dockerfile / npm run build)
gametheca/static/dist/

# Agent scratch: task briefs and reports
.superpowers/

# Team-only competitive intel / banned-token lists — never push
docs/_private/

# Legal sample ROM binaries (operator-fetched; never commit dumps)
samples/free-roms/library/

# Operator BIOS / firmware dumps (never commit; public image is upload-only)
bios/
**/bios/*.bin
**/bios/*.rom
gametheca/static/library/bios/

# Icon packs installed from setup/icon_themes at boot (like themes/)
gametheca/static/library/icon-themes/
gametheca/static/library/chat-emoji/
gametheca/static/library/chat-attachments/

# Uploaded/dropped-in theme fonts (operator-supplied, like icon packs above)
gametheca/static/library/fonts/

# Art-studio output — generated per install, not source
gametheca/static/library/generated/

# WebRetro libretro cores — operator-provisioned, not vendored (71MB of WASM).
#
# These were committed despite cores/README.md describing the directory as
# "operator-owned" and tests/test_webretro_cores.py opening with "no multi-MB
# WASM in repo". They carry a mix of GPL-2.0/3.0, MPL-2.0 and — for snes9x and
# genesis_plus_gx — custom non-commercial terms, and shipping GPL binaries means
# shipping their licence text and a Corresponding Source offer with them.
#
# Fetched on first boot (FETCH_WEBRETRO_CORES_ON_BOOT), or by hand with
# scripts/fetch-webretro-cores.sh --defaults. The README stays tracked.
gametheca/static/vendor/webretro/cores/*_libretro.js
gametheca/static/vendor/webretro/cores/*_libretro.wasm

# Debris from an unexpanded shell variable — never a real project path
%TEMP%/

# Local compose overrides. Compose reads docker-compose.override.yml on top of
# docker-compose.yml automatically, which makes it the right place for facts
# about *this* machine — a GPU device reservation, a local bind mount. Shipping
# one would hand every deployment hardware it may not have.
docker-compose.override.yml
